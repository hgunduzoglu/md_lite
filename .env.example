# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous (public) client key. Never put the service role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "true" to show the signup screen, anything else to hide it.
NEXT_PUBLIC_ENABLE_SIGNUP=true
